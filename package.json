{
  "name": "keysely-admin-panel-backend",
  "version": "0.1.0",
  "description": "Keysely Admin Panel Backend - Serverless API with AWS Lambda and CDK",
  "main": "index.js",
  "scripts": {
    "build": "tsc",
    "watch": "tsc -w",
    "test": "jest",
    "cdk": "cdk",
    "cdk:synth": "cdk synth",
    "cdk:deploy": "cdk deploy",
    "cdk:diff": "cdk diff",
    "docker:up": "docker-compose up",
    "docker:down": "docker-compose down",
    "lint": "eslint . --ext .ts",
    "lint:fix": "eslint . --ext .ts --fix",
    "format": "prettier --write \"**/*.{ts,json,md}\"",
    "dev": "bun --watch src/local-server.ts"
  },
  "engines": {
    "bun": ">=1.0.0"
  },
  "keywords": [
    "aws",
    "cdk",
    "lambda",
    "serverless",
    "typescript"
  ],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@types/aws-lambda": "^8.10.159",
    "@types/bun": "^1.3.4",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.0",
    "@types/node": "^22.0.0",
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "@typescript-eslint/parser": "^6.0.0",
    "aws-cdk": "^2.100.0",
    "dotenv": "^16.3.1",
    "eslint": "^8.0.0",
    "express": "^4.18.2",
    "jest": "^29.5.0",
    "pino-pretty": "^13.1.3",
    "prettier": "^3.0.0",
    "source-map-support": "^0.5.21",
    "ts-jest": "^29.1.0",
    "ts-node": "^10.9.0",
    "typescript": "~5.3.0"
  },
  "dependencies": {
    "aws-cdk-lib": "^2.100.0",
    "constructs": "^10.0.0",
    "pino": "^10.1.0"
  }
}
